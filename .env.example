# Copy this file to .env and fill in your values.

# Required: the API key Hydraloop support gives you.
HYDRALOOP_API_KEY=

# Required: your MQTT broker (the one Home Assistant uses).
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
# Leave empty if the broker allows anonymous clients.
MQTT_USER=
MQTT_PASSWORD=

# Your time zone, used for "today" and "yesterday".
TZ=Europe/Rome

# Optional: only publish this device id (default: every device coupled to the key).
HYDRALOOP_DEVICE_ID=

# Optional: set to false to make the bypass a read-only sensor instead of a switch.
HYDRALOOP_ALLOW_BYPASS_CONTROL=true

# Optional: seconds between API polls (default 600).
POLL_INTERVAL=600

# Optional: Home Assistant MQTT discovery prefix (default homeassistant).
DISCOVERY_PREFIX=homeassistant

# Optional: DEBUG, INFO, WARNING or ERROR (default INFO).
LOG_LEVEL=INFO

# Advanced, normally not needed. The local server is taken per device from the
# root API (localApiUrl). Set this only to force a different one.
# HYDRALOOP_ROOT_URL=https://hdm.hydraloop.com/api-root/external-api
# HYDRALOOP_LOCAL_URL=
